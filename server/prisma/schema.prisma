generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Session {
  id        String   @id
  data      String
  expiresAt DateTime
}

model Technician {
  id          String   @id @default(cuid())
  name        String
  trade       String?
  phone       String?
  color       String   @default("#2563eb")
  active      Boolean  @default(true)
  // Hours available per weekday, Monday first, stored as a JSON array of 7 numbers.
  weeklyHours String   @default("[8,8,8,8,8,0,0]")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  issues      Issue[]
}

model Property {
  id        String   @id @default(cuid())
  name      String
  address   String?
  notes     String?
  // GeoJSON Polygon geometry, stored as JSON text: { "type": "Polygon", "coordinates": [...] }
  boundary  String?
  centerLat Float?
  centerLng Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  issues    Issue[]
}

model Issue {
  id               String   @id @default(cuid())
  propertyId       String
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  actionNeeded     String?
  priority         String   @default("medium") // low | medium | high | urgent
  status           String   @default("pending") // pending | in_progress | completed
  workOrderCreated Boolean  @default(false)
  workOrderNumber  String?
  workOrderUrl     String?
  comments         String?
  lat              Float
  lng              Float
  closedAt         DateTime?
  technicianId     String?
  technician       Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  estimatedHours   Float?
  actualHours      Float?
  // Calendar days as YYYY-MM-DD in the user's local time: when work is planned to start,
  // and when it must be done by.
  scheduledFor     String?
  dueDate          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  photos           Photo[]

  @@index([propertyId])
  @@index([technicianId])
}

model Photo {
  id        String    @id @default(cuid())
  issueId   String
  issue     Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  filename      String
  thumbFilename String?
  hasGps        Boolean   @default(false)
  gpsLat    Float?
  gpsLng    Float?
  takenAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([issueId])
}
