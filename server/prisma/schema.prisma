generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String      @id @default(cuid())
  username           String      @unique
  passwordHash       String
  role               String      @default("admin") // admin | technician | display
  technicianId       String?     @unique
  technician         Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  active             Boolean     @default(true)
  mustChangePassword Boolean     @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime    @default(now())
  notifications      Notification[]
}

// A short message for one signed-in person: a job assigned to them, something due
// or overdue, a status change on their work. Dedupe keys stop the scheduler from
// repeating the same reminder every run.
model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  at         DateTime  @default(now())
  kind       String
  title      String
  body       String?
  issueId    String?
  propertyId String?
  dedupeKey  String?
  readAt     DateTime?

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, at])
}

model Activity {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  userId     String?
  username   String
  action     String
  entityType String
  entityId   String
  propertyId String?
  issueId    String?
  summary    String
  details    String?

  @@index([issueId])
  @@index([propertyId])
  @@index([at])
}

model Session {
  id        String   @id
  data      String
  expiresAt DateTime
}

model Technician {
  id          String   @id @default(cuid())
  name        String
  trade       String?
  phone       String?
  color       String   @default("#2563eb")
  active      Boolean  @default(true)
  // Hours available per weekday, Monday first, stored as a JSON array of 7 numbers.
  weeklyHours String   @default("[8,8,8,8,8,0,0]")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  issues      Issue[]
  timeEntries TimeEntry[]
  user        User?
}

model Property {
  id        String   @id @default(cuid())
  name      String
  address   String?
  notes     String?
  // GeoJSON Polygon geometry, stored as JSON text: { "type": "Polygon", "coordinates": [...] }
  boundary  String?
  centerLat Float?
  centerLng Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  issues    Issue[]
}

model Issue {
  id               String   @id @default(cuid())
  propertyId       String
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  actionNeeded     String?
  priority         String   @default("medium") // low | medium | high | urgent
  status           String   @default("pending") // pending | in_progress | completed
  workOrderCreated Boolean  @default(false)
  workOrderNumber  String?
  workOrderUrl     String?
  comments         String?
  lat              Float
  lng              Float
  closedAt         DateTime?
  technicianId     String?
  technician       Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  estimatedHours   Float?
  actualHours      Float?
  // Calendar days as YYYY-MM-DD in the user's local time: when work is planned to start,
  // and when it must be done by.
  scheduledFor     String?
  dueDate          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  photos           Photo[]
  timeEntries      TimeEntry[]

  @@index([propertyId])
  @@index([technicianId])
}

// One stretch of work on an issue, recorded by clocking in and out. A technician has
// at most one open entry (no endedAt) at a time; the issue's actualHours is the sum.
model TimeEntry {
  id           String     @id @default(cuid())
  issueId      String
  issue        Issue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  userId       String?
  startedAt    DateTime   @default(now())
  endedAt      DateTime?
  note         String?
  createdAt    DateTime   @default(now())

  @@index([issueId])
  @@index([technicianId, startedAt])
}

model Photo {
  id        String    @id @default(cuid())
  issueId   String
  issue     Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  filename      String
  thumbFilename String?
  hasGps        Boolean   @default(false)
  gpsLat    Float?
  gpsLng    Float?
  takenAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([issueId])
}
