generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String         @id @default(cuid())
  username           String         @unique
  passwordHash       String
  role               String         @default("admin") // admin | technician | display
  technicianId       String?        @unique
  technician         Technician?    @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  active             Boolean        @default(true)
  mustChangePassword Boolean        @default(false)
  lastLoginAt        DateTime?
  // Secret in the calendar-feed URL; rotating it invalidates any subscribed calendar.
  feedToken          String?        @unique
  createdAt          DateTime       @default(now())
  notifications      Notification[]
}

// A short message for one signed-in person: a job assigned to them, something due
// or overdue, a status change on their work. Dedupe keys stop the scheduler from
// repeating the same reminder every run.
model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  at         DateTime  @default(now())
  kind       String
  title      String
  body       String?
  issueId    String?
  propertyId String?
  dedupeKey  String?
  readAt     DateTime?

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, at])
}

model Activity {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  userId     String?
  username   String
  action     String
  entityType String
  entityId   String
  propertyId String?
  issueId    String?
  summary    String
  details    String?

  @@index([issueId])
  @@index([propertyId])
  @@index([at])
}

model Session {
  id        String   @id
  data      String
  expiresAt DateTime
}

model Technician {
  id          String          @id @default(cuid())
  name        String
  trade       String?
  phone       String?
  color       String          @default("#2563eb")
  active      Boolean         @default(true)
  // Hours available per weekday, Monday first, stored as a JSON array of 7 numbers.
  // Either 7 numbers (legacy hours per day) or 7 shift objects {start,end} / null,
  // Monday first. Read through parseShifts, which normalises both shapes.
  weeklyHours String          @default("[{\"start\":\"08:00\",\"end\":\"16:00\"},{\"start\":\"08:00\",\"end\":\"16:00\"},{\"start\":\"08:00\",\"end\":\"16:00\"},{\"start\":\"08:00\",\"end\":\"16:00\"},{\"start\":\"08:00\",\"end\":\"16:00\"},null,null]")
  // Work categories this technician covers, as a JSON array of category keys.
  categories  String          @default("[]")
  // Charge-out rate used to value clocked time on an issue.
  hourlyRate  Float?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  issues      Issue[]
  timeEntries TimeEntry[]
  schedules   Schedule[]
  user        User?
  assignments IssueAssignee[]
  inspections Inspection[]
  timeOff     TimeOff[]
  walkthroughs Walkthrough[]
  ownedProjects Project[]
  stakeholderIn Stakeholder[]
  blockersOwned Blocker[]
}

model Property {
  id            String        @id @default(cuid())
  name          String
  address       String?
  notes         String?
  // GeoJSON Polygon geometry, stored as JSON text: { "type": "Polygon", "coordinates": [...] }
  boundary      String?
  centerLat     Float?
  centerLng     Float?
  // Secret in the public guest-reporting link. Null until an admin turns it on;
  // rotating it kills every QR code and printed card already in circulation.
  intakeToken   String?       @unique
  intakeEnabled Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  issues        Issue[]
  schedules     Schedule[]
  guestReports  GuestReport[]
  inspections   Inspection[]
  projects      Project[]
  walkthroughs Walkthrough[]
  calendars     WorkCalendar[]
  meterPoints   MeterPoint[]
  utilityInvoices UtilityInvoice[]
  spaces        Space[]
  assets        Asset[]
}

model Issue {
  id               String           @id @default(cuid())
  propertyId       String
  property         Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  actionNeeded     String?
  priority         String           @default("medium") // low | medium | high | urgent
  status           String           @default("pending") // pending | in_progress | completed
  // Trade the work belongs to, used to suggest who should pick it up.
  category         String?
  // Room or sub-location within the property, e.g. "Room 214" or "Pool plant room".
  //
  // Kept as free text even now there is a Space tree. Three hundred and forty rooms
  // of history were typed by hand and a migration that guessed at them would be
  // wrong in ways nobody could audit, so the two coexist: spaceId where somebody
  // has matched it up, this where they have not, and every read falls back to it.
  roomName         String?
  spaceId          String?
  space            Space?           @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  /// The thing that is faulty, where it is a known piece of equipment rather than
  /// a place. A pump has a service history; "the plant room" does not.
  assetId          String?
  asset            Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)
  workOrderCreated Boolean          @default(false)
  workOrderNumber  String?
  workOrderUrl     String?
  lat              Float
  lng              Float
  closedAt         DateTime?
  technicianId     String?
  technician       Technician?      @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  /// Set when this issue was reconciled out of a walk-through, so the walk can
  /// show what it produced and the issue can say where it came from.
  walkthroughId    String?
  walkthrough      Walkthrough?     @relation(fields: [walkthroughId], references: [id], onDelete: SetNull)
  estimatedHours   Float?
  actualHours      Float?
  // Calendar days as YYYY-MM-DD in the user's local time: when work is planned to start,
  // and when it must be done by.
  scheduledFor     String?
  dueDate          String?
  // The moment this is due. A two-hour job needs a time, not a date; dueDate stays as
  // the day it falls on so the day-level planning views keep working unchanged.
  dueAt            DateTime?
  // Position in the assigned technician's day, lowest first. Set by the scheduler.
  dayOrder         Int?
  // Emergencies are slotted in ahead of planned work and push the rest back.
  isEmergency      Boolean          @default(false)
  // While an emergency has displaced this job, the emergency that did it and the slot
  // to put it back in once that emergency closes.
  shiftedBy        String?
  orderBeforeShift Int?
  // Set when the scheduler last raised this issue's priority for being overdue.
  escalatedAt      DateTime?
  // Set when several pieces of work are being run together as one job of work.
  projectId        String?
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Work breakdown. A parent is an ordinary issue with children — "replace the AHU"
  /// over "isolate", "lift out", "install", "commission". There is deliberately no
  /// separate phase table: one object at several levels is what lets a budget or a
  /// percentage roll up without a special case per level.
  parentId         String?
  parent           Issue?           @relation("IssueHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Issue[]          @relation("IssueHierarchy")
  /// A dateline with no duration — a permit granted, a delivery landing, handover.
  /// It still carries a position because every issue does; the map leaves it out.
  isMilestone      Boolean          @default(false)
  /// How far along, 0 to 100. Construction work is not done or not-done: a pour is
  /// 60 per cent poured. Null means nobody has said, which is different from zero.
  /// On a parent this is ignored and computed from the children instead.
  percentComplete  Int?
  /// The dates this was *planned* for, frozen when the plan was agreed. Kept apart
  /// from scheduledFor/dueDate so that slippage stays visible instead of being
  /// overwritten by the current answer.
  baselineStart    String?
  baselineDue      String?
  linksOut         IssueLink[]      @relation("LinkFrom")
  linksIn          IssueLink[]      @relation("LinkTo")
  quotes           Quote[]
  blockers         Blocker[]
  // Set when a recurring maintenance schedule created this issue.
  scheduleId       String?
  schedule         Schedule?        @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  photos           Photo[]
  timeEntries      TimeEntry[]
  checklist        ChecklistItem[]
  costs            Cost[]
  tags             IssueTag[]
  messages         Message[]
  assignees        IssueAssignee[]
  // The inspection finding this issue was raised from, when it came from one.
  fromCheck        InspectionCheck?
  guestReport      GuestReport?

  @@index([propertyId])
  @@index([technicianId])
  @@index([projectId])
  @@index([parentId])
  @@index([spaceId])
  @@index([assetId])
}

// One stretch of work on an issue, recorded by clocking in and out. A technician has
// at most one open entry (no endedAt) at a time; the issue's actualHours is the sum.
model TimeEntry {
  id           String     @id @default(cuid())
  issueId      String
  issue        Issue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  userId       String?
  startedAt    DateTime   @default(now())
  endedAt      DateTime?
  note         String?
  createdAt    DateTime   @default(now())

  @@index([issueId])
  @@index([technicianId, startedAt])
}

// Belongs to an issue, or to a guest report until that report is accepted and the
// photos move across with it. Exactly one of the two is set.
model Photo {
  id            String           @id @default(cuid())
  issueId       String?
  issue         Issue?           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  guestReportId String?
  guestReport   GuestReport?     @relation(fields: [guestReportId], references: [id], onDelete: Cascade)
  checkId       String?
  check         InspectionCheck? @relation(fields: [checkId], references: [id], onDelete: Cascade)
  /// A photo taken on a walk-through that has not been grouped into an issue yet.
  /// Grouping moves it onto the issue, so at most one of these is ever set.
  walkthroughId String?
  walkthrough   Walkthrough?     @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  /// A photo OF a piece of equipment — the nameplate, the panel schedule, where
  /// the valve actually is. Not a fault: a fault is an issue and its photos hang
  /// off that. This is what the manual is for, and it is the difference between
  /// a register entry and knowing what you are looking for when you get there.
  assetId       String?
  asset         Asset?           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  filename      String
  thumbFilename String?
  hasGps        Boolean          @default(false)
  gpsLat        Float?
  gpsLng        Float?
  /// "exif" when the camera recorded it, "device" when the phone's own GPS was
  /// used instead. A report should not present the two as the same thing.
  gpsSource     String?
  takenAt       DateTime?
  createdAt     DateTime         @default(now())

  @@index([issueId])
  @@index([guestReportId])
  @@index([checkId])
  @@index([walkthroughId])
  @@index([assetId])
}

// Organisation-wide settings (turnaround days per priority, escalation rules), one JSON row.
model Setting {
  id        String   @id
  json      String
  updatedAt DateTime @updatedAt
}

// A recurring maintenance task (gutters every 3 months, boiler service yearly…). The
// scheduler turns it into a normal issue `leadDays` before each due date.
model Schedule {
  id             String      @id @default(cuid())
  propertyId     String
  property       Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  actionNeeded   String?
  priority       String      @default("medium")
  category       String?
  roomName       String?
  technicianId   String?
  technician     Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  estimatedHours Float?
  lat            Float
  lng            Float
  every          Int         @default(1)
  unit           String      @default("months") // days | weeks | months
  leadDays       Int         @default(7)
  nextDue        String // YYYY-MM-DD
  checklist      String      @default("[]") // JSON array of item texts
  active         Boolean     @default(true)
  lastCreatedAt  DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  issues         Issue[]

  @@index([propertyId])
}

// Tick-box steps on an issue (from a schedule's template or added by hand).
model ChecklistItem {
  id       String    @id @default(cuid())
  issueId  String
  issue    Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  text     String
  position Int       @default(0)
  done     Boolean   @default(false)
  doneAt   DateTime?
  doneBy   String?

  @@index([issueId])
}

// An outside firm or tradesperson used for work the in-house crew doesn't cover.
model Contractor {
  id        String   @id @default(cuid())
  name      String
  trade     String?
  phone     String?
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  costs     Cost[]
  quotes    Quote[]
}

// Money spent on an issue: parts, an invoice from a contractor, hire, disposal…
model Cost {
  id           String      @id @default(cuid())
  issueId      String
  issue        Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  kind         String      @default("parts") // parts | contractor | hire | other
  description  String
  amount       Float
  quantity     Float       @default(1)
  contractorId String?
  contractor   Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  invoiceRef   String?
  incurredOn   String // YYYY-MM-DD
  createdBy    String?
  createdAt    DateTime    @default(now())

  @@index([issueId])
  @@index([contractorId])
}

// A label for the kind of work, seeded with the hotel set and extendable by an admin.
model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String     @default("#475569")
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  issues    IssueTag[]
}

model IssueTag {
  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([issueId, tagId])
  @@index([tagId])
}

// A line in an issue's conversation. Kept separately from the issue so every remark
// carries who said it and when, and nothing overwrites anything else.
model Message {
  id         String    @id @default(cuid())
  issueId    String
  issue      Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId     String?
  authorName String
  body       String
  editedAt   DateTime?
  createdAt  DateTime  @default(now())

  @@index([issueId, createdAt])
}

// Something reported through a property's public link by someone with no login — a
// guest, a housekeeper, a front-desk shift. It is not an issue yet: an admin reads it
// and either accepts it (which creates the issue and moves the photos over) or turns
// it down, with the record kept either way.
model GuestReport {
  id           String    @id @default(cuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomName     String
  category     String?
  description  String
  status       String    @default("pending") // pending | accepted | declined
  // Taken from a submitted photo's EXIF when one had GPS, so the pin starts in the
  // right place; null means the reviewer positions it themselves.
  lat          Float?
  lng          Float?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   String?
  reviewNote   String?
  issueId      String?   @unique
  issue        Issue?    @relation(fields: [issueId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  photos       Photo[]

  @@index([status, createdAt])
  @@index([propertyId])
}

// A technician working on an issue. An issue can have up to four, and the one in
// Issue.technicianId is the lead — they are mirrored here too, so "what is this person
// on today" is a single query.
model IssueAssignee {
  id           String     @id @default(cuid())
  issueId      String
  issue        Issue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([issueId, technicianId])
  @@index([technicianId])
}

// Days a technician is not available: vacation, sick leave, training. Inclusive of both
// ends, stored as YYYY-MM-DD like every other calendar day in the app.
model TimeOff {
  id           String     @id @default(cuid())
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  startDay     String
  endDay       String
  kind         String     @default("vacation") // vacation | sick | training | other
  note         String?
  createdAt    DateTime   @default(now())

  @@index([technicianId, startDay])
  @@index([startDay, endDay])
}

// ---------------------------------------------------------------------------
// Inspections
//
// A self-contained corner of the schema: templates describe what to look at, an
// Inspection is one walk through a room, and each InspectionCheck is one line of
// that walk. Nothing outside this block depends on it — the only links pointing
// the other way are Photo.checkId and Issue.fromCheck — so the whole domain can
// be lifted into its own service later without unpicking the rest.
// ---------------------------------------------------------------------------

/// A reusable list of what to look at: "Guest room", "Public area", "Plant room".
model InspectionTemplate {
  id          String              @id @default(cuid())
  name        String
  description String?
  /// Null means it can be used on any property.
  propertyId  String?
  active      Boolean             @default(true)
  sortOrder   Int                 @default(0)
  /// Which revision of the built-in checklist this template has had applied.
  /// Lets a later release add the points experience says were missing, without
  /// reinstating anything somebody deliberately took out.
  seedVersion Int                 @default(0)
  /// "checklist" walks a fixed list of points. "general" has no list at all —
  /// blank slots the person fills in as they find things.
  kind        String              @default("checklist")
  /// What to show in the empty area field, since a room number and a poolside
  /// are both areas but nobody types them the same way.
  areaHint    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  sections    InspectionSection[]
  inspections Inspection[]

  @@index([active, sortOrder])
}

/// A part of the room, so a walkthrough follows the way somebody actually moves.
model InspectionSection {
  id         String             @id @default(cuid())
  templateId String
  template   InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  position   Int                @default(0)
  points     InspectionPoint[]

  @@index([templateId, position])
}

/// One thing to look at, and what to look for.
model InspectionPoint {
  id        String            @id @default(cuid())
  sectionId String
  section   InspectionSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  label     String
  /// The detail that stops this being a tick-box: what "not right" looks like here.
  hint      String?
  /// The trade this usually belongs to, carried onto any issue raised from it.
  category  String?
  /// When set, this point expects a number rather than only a judgement:
  /// °C, mg/L, pH, bar, ppm, hours, %. The presence of a unit is what makes a
  /// point a measurement.
  unit      String?
  /// The acceptable range. Either end may be open — a hot-water outlet has a
  /// minimum and no useful maximum; a fridge has both.
  minOk     Float?
  maxOk     Float?
  position  Int               @default(0)

  @@index([sectionId, position])
}

/// One walk through one room.
model Inspection {
  id           String              @id @default(cuid())
  propertyId   String
  property     Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  templateId   String?
  template     InspectionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// Snapshot, so renaming or deleting a template never rewrites history.
  templateName String
  /// What was typed, kept for the same reason as on Issue: it is the record of
  /// what somebody wrote, and the tree is matched up beside it rather than over it.
  roomName     String
  spaceId      String?
  space        Space?              @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  status       String              @default("in_progress") // in_progress | completed | abandoned
  /// The login that typed it in.
  inspectorId  String?
  /// Who actually walked the room. Usually the same person, but an admin can
  /// record a walk on someone else's behalf, and the report should name them.
  technicianId String?
  technician   Technician?         @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  inspector    String
  /// Where the walk was, from the phone's own GPS. Used to place a finding that
  /// has no photo, or whose photos carry no location of their own.
  lat          Float?
  lng          Float?
  notes        String?
  startedAt    DateTime            @default(now())
  completedAt  DateTime?
  /// When a finished walk was last reopened to correct something. A report that
  /// has been changed since it was first signed off has to say so, or a printed
  /// copy and the live one disagree with nobody able to tell which is current.
  amendedAt    DateTime?
  /// When the walk was archived: closed off as a record, with its raw photos
  /// released unless an issue still needs them.
  archivedAt   DateTime?
  /// What the walk found, frozen as JSON at the moment of archiving. The report
  /// reads from this afterwards, so it keeps saying the same thing on the same
  /// date once the photographs behind it are gone.
  summary      String?
  checks       InspectionCheck[]

  @@index([propertyId, startedAt])
  @@index([status])
  @@index([technicianId])
}

/// One line of a walk: a template point that was looked at, or something spotted
/// that was not on the list at all.
model InspectionCheck {
  id           String     @id @default(cuid())
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  /// Null for anything found that the template did not ask about.
  pointId      String?
  /// Snapshots of the template wording at the time of the walk.
  section      String
  label        String
  hint         String?
  category     String?
  /// ok | flagged | na — "ok" lines are kept so the report shows what was checked
  /// and passed, not only what went wrong.
  outcome      String     @default("ok")
  /// minor | moderate | major, on a flagged line.
  severity     String?
  note         String?
  /// Where this particular finding is. A checklist walk gets its area from the
  /// inspection, because the whole walk is one room; a general walk covers
  /// ground, so each finding carries its own.
  area         String?
  /// The number that was read. Null means nobody took a reading, which is not
  /// the same as a reading of zero — a chlorine level of 0 is a problem and an
  /// unrecorded one is a gap in the round.
  value        Float?
  /// Snapshots of what the point expected, alongside the label and hint that are
  /// already copied. A report from six months ago then shows the range that was
  /// in force at the time rather than today's, which is the whole reason the
  /// wording is snapshotted too.
  unit         String?
  minOk        Float?
  maxOk        Float?
  position     Int        @default(0)
  /// Set once this finding has been turned into work.
  issueId      String?    @unique
  issue        Issue?     @relation(fields: [issueId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  photos       Photo[]

  @@index([inspectionId, position])
  @@index([outcome])
}

/// Several pieces of work run together — a room refurbishment, a floor's worth of
/// snagging. A project is a grouping of issues, not a second kind of work.
model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  status      String    @default("open") // planning | open | on_hold | done | cancelled
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  issues      Issue[]

  /// Who is answerable for it. The roster rather than the login list, because the
  /// person who owns a job is not always the person who types into the app.
  ownerId     String?
  owner       Technician? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  /// Calendar days as YYYY-MM-DD, matching the convention on Issue.
  plannedStart String?
  plannedEnd   String?
  /// The agreed plan, frozen. See the note on Issue.baselineStart.
  baselineStart String?
  baselineEnd   String?
  /// Approved spend. Bare amount, like Cost.amount — this app is single-currency
  /// and inventing a currency column here without one there would be worse.
  budgetAmount Float?
  /// Sign-off. The department rule is a supervisor plus one of the assistant chiefs
  /// or the chief, so the approver is recorded by name rather than inferred.
  approvedBy  String?
  approvedAt  DateTime?
  quotes      Quote[]
  linksOut    ProjectLink[] @relation("ProjectLinkFrom")
  linksIn     ProjectLink[] @relation("ProjectLinkTo")
  blockers    Blocker[]
  stakeholders Stakeholder[]

  @@index([status, createdAt])
  @@index([ownerId])
}


/// A walk-round of a property, recorded as it happens.
///
/// Deliberately not an Inspection. An inspection answers a fixed checklist room
/// by room; a walk-through is someone covering ground with a phone, shooting what
/// they see and sorting it out afterwards. Forcing the two together would mean a
/// checklist nobody filled in and a template that fits neither.
///
/// The photos arrive first and belong to the walk. Grouping some of them mints an
/// Issue and moves them onto it, which is the reconciliation step — so a walk in
/// progress is a pile of evidence, and a finished one is a list of issues plus a
/// record of who covered what, and when.
model Walkthrough {
  id           String      @id @default(cuid())
  propertyId   String
  property     Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Who walked it. Null when the login is not linked to anybody on the team.
  technicianId String?
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  /// The name recorded at the time, kept verbatim: a person can leave, and the
  /// record of who walked the building on a given night should not change.
  walkedBy     String
  /// How the walk is being worked.
  ///
  /// "group"  — photograph everything, sort it into issues afterwards. Right when
  ///            covering ground fast and the findings are not yet obvious.
  /// "direct" — one named issue at a time, photographs optional. Right when
  ///            standing in a room working through what is wrong with it.
  ///
  /// Stored rather than asked again, because a walk gets put down and picked up,
  /// and landing somebody in the other screen halfway through loses their place.
  mode         String      @default("group")
  /// Where the walk is, when it is being worked a room at a time. The default for
  /// issues logged next, not a property of the walk itself.
  spaceId      String?
  space        Space?      @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  roomName     String?
  /// Which areas were covered, written by the person who covered them.
  areas        String?
  notes        String?
  startedAt    DateTime    @default(now())
  completedAt  DateTime?
  /// Where the walk started, from the phone. A photo may carry its own, which
  /// takes precedence when one is grouped into an issue.
  lat          Float?
  lng          Float?
  photos       Photo[]
  issues       Issue[]

  @@index([propertyId, startedAt])
  @@index([completedAt])
}

/// A typed dependency between two pieces of work. A maintenance department runs on
/// "the scaffold comes down before the painters start", and that is a graph rather
/// than an ordering: one job can block several and follow several others.
model IssueLink {
  id          String   @id @default(cuid())
  fromIssueId String
  from        Issue    @relation("LinkFrom", fields: [fromIssueId], references: [id], onDelete: Cascade)
  toIssueId   String
  to          Issue    @relation("LinkTo", fields: [toIssueId], references: [id], onDelete: Cascade)
  /// The four scheduling relationships, named plainly rather than as FS/SS/FF:
  ///   precedes            — from finishes before to starts (finish-to-start)
  ///   starts_after_start  — to starts after from starts (start-to-start)
  ///   finishes_after_finish — to finishes after from finishes (finish-to-finish)
  /// and two that carry no dates:
  ///   blocks  — from stops to happening at all
  ///   relates — worth reading together, no constraint
  ///
  /// Start-to-start and finish-to-finish are not niceties on heavy work: shoring
  /// starts two days after excavation starts and runs alongside it, and curing
  /// finishes when the pour finishes. Finish-to-start alone cannot say either.
  kind        String   @default("precedes")
  /// Days of slack to add after `from` finishes, for a "precedes" link. Paint needs
  /// a day to dry whether or not anybody is working on it.
  lagDays     Int?
  createdAt   DateTime @default(now())

  @@unique([fromIssueId, toIssueId, kind])
  @@index([toIssueId])
}

/// A quote from a contractor, against either one job or a whole project.
///
/// The department rule is at least three quotes on a contractor job, with the EAM
/// team sending the request and notifying the award. That rule is currently kept in
/// people's heads; as a table it becomes a field you can test and an award you can
/// audit, which is the whole point.
model Quote {
  id           String      @id @default(cuid())
  /// Exactly one of these is set. Enforced in the route rather than by a CHECK,
  /// which Prisma cannot express on SQLite.
  issueId      String?
  issue        Issue?      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractorId String
  contractor   Contractor  @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  amount       Float?
  /// requested — RFQ sent, nothing back yet
  /// received  — a number is in
  /// declined  — they will not quote
  /// awarded   — this is the one that won
  status       String      @default("requested")
  reference    String?
  notes        String?
  requestedAt  DateTime    @default(now())
  receivedAt   DateTime?
  awardedAt    DateTime?
  decidedBy    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([issueId])
  @@index([projectId])
  @@index([contractorId])
}

/// A dependency between two whole projects.
///
/// Separate from IssueLink rather than generalised over both. A link between two
/// jobs and a link between two programmes are read by different people for
/// different reasons, and a single polymorphic edge table would make every query
/// filter on a discriminator to get either. The two graphs are also walked
/// independently — project order does not constrain job order within a project.
model ProjectLink {
  id            String   @id @default(cuid())
  fromProjectId String
  from          Project  @relation("ProjectLinkFrom", fields: [fromProjectId], references: [id], onDelete: Cascade)
  toProjectId   String
  to            Project  @relation("ProjectLinkTo", fields: [toProjectId], references: [id], onDelete: Cascade)
  /// precedes — from finishes before to starts
  /// blocks    — from stops to proceeding, no date arithmetic implied
  /// relates   — worth reading together, no constraint
  kind          String   @default("precedes")
  lagDays       Int?
  createdAt     DateTime @default(now())

  @@unique([fromProjectId, toProjectId, kind])
  @@index([toProjectId])
}

/// Something stopping work that is nobody's fault in particular.
///
/// Deliberately not the same thing as a dependency. A dependency says "this comes
/// after that" and resolves itself when that finishes. A blocker says "this cannot
/// proceed and somebody has to go and do something about it" — it has an owner, a
/// reason, an age, and an explicit moment it was cleared. Those are the two
/// questions a stand-up actually asks, and a link kind cannot answer either.
///
/// The age is the point. A blocker open for three weeks is a different problem from
/// one raised this morning, and nothing in a dependency graph can tell you which
/// you have.
model Blocker {
  id           String      @id @default(cuid())
  /// Exactly one target. Enforced in the route; SQLite cannot express it here.
  issueId      String?
  issue        Issue?      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// What kind of thing is in the way. These are the ones that actually recur:
  /// parts | approval | access | contractor | information | weather | budget | other
  kind         String      @default("other")
  summary      String
  /// Who is chasing it. The roster where it is one of ours, free text where it is
  /// a supplier, a head office or an inspector.
  ownerId      String?
  owner        Technician? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerName    String?
  raisedBy     String?
  raisedAt     DateTime    @default(now())
  /// A blocker is cleared, not deleted — how long things sit in the way is the
  /// most useful thing this table knows, and deleting them throws it away.
  clearedAt    DateTime?
  clearedBy    String?
  resolution   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([issueId])
  @@index([projectId])
  @@index([clearedAt])
  @@index([ownerId])
}

/// Someone with an interest in a project, and what kind of interest it is.
///
/// Roles follow the usual responsibility split rather than inventing a vocabulary:
/// a sponsor pays for it, an approver signs it off, the accountable one answers for
/// it, the consulted are asked before decisions, the informed are told afterwards.
/// Getting these written down is most of what stakeholder management is — the
/// common failure is not disagreement, it is somebody finding out late.
///
/// External people are first-class. An insurer's auditor, a regional engineer and a
/// public-health lab are all stakeholders and none of them will ever have a login
/// here, so a name and an organisation are enough.
model Stakeholder {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// One of the roster, or a name and an organisation for anyone outside it.
  technicianId String?
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  name         String?
  organisation String?
  /// sponsor | approver | accountable | consulted | informed
  role         String      @default("informed")
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([projectId])
  @@index([technicianId])
}

/// Which days work actually happens on.
///
/// Opt-in per property, and deliberately so: without one, durations are counted in
/// calendar days, which is what this app did before calendars existed. Creating a
/// calendar changes every float figure on that property's programmes, so it has to
/// be a decision somebody makes rather than something that happens on deploy.
model WorkCalendar {
  id         String    @id @default(cuid())
  /// Null means it is the fallback for properties with none of their own.
  propertyId String?   @unique
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String    @default("Working days")
  /// Seven booleans, Monday first, as a JSON array — the same shape and reasoning
  /// as Technician.weeklyHours.
  workingDays String   @default("[true,true,true,true,true,true,false]")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  exceptions CalendarException[]
}

/// A single day that goes against the weekly pattern.
///
/// Both directions matter and only one is usually remembered. A public holiday or a
/// shutdown makes a normal working day non-working; a weekend worked to claw back a
/// slipped pour makes a non-working day working. A calendar that could only hold
/// holidays would be wrong by exactly the days a programme cares about most.
model CalendarException {
  id         String       @id @default(cuid())
  calendarId String
  calendar   WorkCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD, matching the date convention everywhere else.
  day        String
  /// True when this day IS worked despite the pattern; false when it is not.
  working    Boolean      @default(false)
  reason     String?
  createdAt  DateTime     @default(now())

  @@unique([calendarId, day])
  @@index([calendarId])
}

/// Something that gets read twice a day.
///
/// A meter, a bulk tank, a water tank. What makes this worth a table rather than a
/// column is that the three are read in completely different ways and all end up
/// as the same thing: an electricity meter gives a running total in kWh, a propane
/// tank gives a percentage of its own capacity, and a water tank gives a height
/// that is a fraction of its maximum. The entry mode says which, and the raw value
/// is always kept beside the converted one so a conversion can be checked, or
/// corrected later, without losing what somebody actually wrote down.
model MeterPoint {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  /// electricity | water | propane | diesel
  kind       String
  /// direct      — the gauge reads in the unit, as a running total or a level
  /// percentage  — a percentage of capacity; litres come from capacityLitres
  /// tank_height — a height; litres come from the fraction of tankMaxHeightMm
  entryMode  String   @default("direct")
  /// The unit the stored value is in. Never assumed: a water meter read in US
  /// gallons is recorded in gallons and converted once, visibly, rather than the
  /// whole app guessing. This is what stops the litres-or-gallons question from
  /// being a global one.
  unit       String
  capacityLitres  Float?
  tankMaxHeightMm Float?
  /// Whether this rolls into the site total. The incoming line and the submeters
  /// beneath it would otherwise be counted twice.
  includeInSiteTotal Boolean @default(true)
  /// A running total that only goes up (an electricity meter) versus a level that
  /// goes up and down (a tank). Consumption is the difference for the first and
  /// the drop for the second, and getting it wrong inverts the number.
  cumulative Boolean  @default(true)
  active     Boolean  @default(true)
  notes      String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  readings   Reading[]

  @@index([propertyId, kind])
}

/// One reading, at one of the two times of day it is taken.
model Reading {
  id           String     @id @default(cuid())
  meterPointId String
  meterPoint   MeterPoint @relation(fields: [meterPointId], references: [id], onDelete: Cascade)
  takenAt      DateTime
  /// "0200" or "0500" — the two rounds. Stored rather than derived from takenAt,
  /// because a round taken late is still that round's reading.
  slot         String
  /// The 05:00-to-05:00 day this belongs to, as YYYY-MM-DD, worked out on write.
  /// A reading at 02:00 belongs to the day that began at 05:00 the morning before,
  /// which is the whole reason this is stored rather than taken from the date.
  readingDay   String
  /// Exactly what was read: 47 (per cent), 1320 (mm), 918273 (kWh).
  rawValue     Float
  /// The same reading in the meter point's unit, after conversion.
  value        Float
  takenBy      String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  /// One reading per point per round per day. A second one is a correction to the
  /// first, not another data point.
  @@unique([meterPointId, readingDay, slot])
  @@index([meterPointId, readingDay])
  @@index([readingDay])
}

/// What a utility actually cost for a period, with the bill behind it.
///
/// Here because a claim that electricity rose thirty per cent is not something an
/// app should accept as input. Store the invoice — the amount, the quantity billed,
/// the period — and cost per unit is derived, which means any trend the app states
/// it can show its working for. That is the difference between a figure that can go
/// into a monthly report and one that cannot.
model UtilityInvoice {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  kind        String
  /// YYYY-MM-DD, inclusive.
  periodStart String
  periodEnd   String
  /// Bare amount, like Cost.amount — this app is single-currency.
  amount      Float
  /// How much was billed, and in what. Cost per unit is amount / quantity.
  quantity    Float
  unit        String
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([propertyId, kind, periodStart, periodEnd])
  @@index([propertyId, kind, periodStart])
}

/// Where something is, as a tree rather than a sentence.
///
/// Property, then block, then floor, then the space itself — a guest room, a plant
/// room, a stretch of pool deck. The blocks here are named things with their own
/// character: Coubaril, Millionaire, Point Suites, Blue Suites, Tennis.
///
/// This exists because "Room 214" as free text cannot answer any of the questions
/// that matter once a site is large: everything in Coubaril, every room on floor
/// two, how many of the sellable rooms are out of order. A string can be matched
/// and counted; it cannot be walked.
///
/// It does not replace the free text. Three hundred and forty rooms of history were
/// typed by hand, and a migration that guessed which string meant which room would
/// be wrong in ways nobody could check afterwards. So the two coexist and the text
/// is matched up as somebody gets to it.
model Space {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Null for a top-level block. A floor hangs off a block, a room off a floor.
  parentId   String?
  parent     Space?   @relation("SpaceTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Space[]  @relation("SpaceTree")
  /// block | floor | space
  kind       String   @default("space")
  name       String
  /// The short reference people actually say: "214", "P3", "DB-2".
  code       String?
  /// Whether this is a room that can be sold. What makes the sell-status tracker
  /// possible without a second subsystem: back of house is excluded by not being
  /// sellable rather than by a list of exceptions.
  sellable   Boolean  @default(false)
  /// green | amber | red, for the weekly sell-status round. Null until somebody says.
  sellStatus String?
  /// A space can have its own position, for the ones worth putting on a map.
  lat        Float?
  lng        Float?
  notes      String?
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  issues     Issue[]
  inspections Inspection[]
  assets     Asset[]
  servedBy   AssetRelation[]
  walkthroughs Walkthrough[]

  @@unique([propertyId, parentId, name])
  @@index([propertyId, kind])
  @@index([parentId, sortOrder])
  @@index([propertyId, sellable, sellStatus])
}

/// A piece of equipment, in a place, with a service history.
///
/// Every other part of this app helps record a problem. This is the part that helps
/// act on one, and the questions it exists to answer are the ones that cost the
/// most time standing in a corridor at two in the morning:
///
///   - which breaker isolates room 214, and which panel is it in
///   - which valve shuts this pipe without dropping the whole block
///   - what else goes dark if I open this breaker
///
/// The last one is why this cannot be a list of equipment with photographs. It
/// needs the connections, and they are a graph rather than a tree — see
/// AssetRelation.
model Asset {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Where it is. A breaker is in a panel which is in a riser; the riser is the
  /// space, the panel is the parent.
  spaceId    String?
  space      Space?   @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  /// Containment, not supply. A breaker lives inside a panel; a pump sits in a
  /// plant room. What it FEEDS is a relation, which is a different thing entirely
  /// and the distinction is the whole point of having both.
  parentId   String?
  parent     Asset?   @relation("AssetTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Asset[]  @relation("AssetTree")
  /// panel | breaker | valve | generator | tank | pump | ahu | fcu | ice_machine
  /// lift | meter | grease_trap | calorifier | chiller | other
  kind       String
  /// What people actually say: "DB-3", "CB-14", "V-207", "GEN-1".
  ref        String?
  name       String
  manufacturer String?
  model      String?
  serialNumber String?
  /// Free text, because a rating is "80A" for a breaker and "250 kVA" for a
  /// generator and nobody wins by forcing those into one number.
  rating     String?
  installedAt DateTime?
  lat        Float?
  lng        Float?
  /// Service interval in days. The 90-day air-conditioning standard lives here, on
  /// the equipment, rather than as a column in a tracker — which is what makes
  /// "everything overdue" a query over the whole site rather than a spreadsheet.
  serviceIntervalDays Int?
  lastServicedAt DateTime?
  notes      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  issues     Issue[]
  photos     Photo[]
  relationsOut AssetRelation[] @relation("RelationFrom")
  relationsIn  AssetRelation[] @relation("RelationTo")
  services   AssetService[]

  @@index([propertyId, kind])
  @@index([spaceId])
  @@index([parentId])
  @@index([propertyId, lastServicedAt])
}

/// What one thing does to another, or to a place.
///
/// A directed graph, deliberately, and not a tree. One room is fed by a breaker
/// and served by a valve and conditioned by an air handler, and each of those has
/// its own upstream. Modelling it as a tree would be simpler and would be wrong:
/// the question people actually ask is the inverse — "what feeds this room" — and
/// a tree can only answer it in one direction.
///
/// The target is either another asset or a space, because both are real: a breaker
/// feeds a sub-panel (asset) and also feeds room 214 (space).
model AssetRelation {
  id          String  @id @default(cuid())
  fromAssetId String
  from        Asset   @relation("RelationFrom", fields: [fromAssetId], references: [id], onDelete: Cascade)
  /// Exactly one of these. Enforced in the route; SQLite cannot say it here.
  toAssetId   String?
  to          Asset?  @relation("RelationTo", fields: [toAssetId], references: [id], onDelete: Cascade)
  toSpaceId   String?
  toSpace     Space?  @relation(fields: [toSpaceId], references: [id], onDelete: Cascade)
  /// feeds    — electrical supply
  /// isolates — a valve or switch that cuts it off
  /// serves   — supplies something that is not electricity: water, air, gas
  /// drains   — takes waste away from it
  /// vents    — extracts air from it
  kind        String  @default("feeds")
  notes       String?
  createdAt   DateTime @default(now())

  @@index([fromAssetId])
  @@index([toAssetId])
  @@index([toSpaceId])
}

/// A service or a test, recorded against the equipment it was done to.
///
/// Separate from the issue that may have prompted it. The weekly generator no-load
/// test and the monthly load test are not faults and do not belong in a fault log,
/// but the record of them is exactly what an insurer asks for.
model AssetService {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// service | test | repair | replacement | inspection
  kind      String   @default("service")
  performedAt DateTime
  performedBy String?
  /// What was done, and anything measured while doing it — run hours, a load
  /// reading, an insulation value.
  summary   String
  reading   Float?
  unit      String?
  /// Whether the equipment passed. Null for work with no pass or fail about it.
  passed    Boolean?
  createdAt DateTime @default(now())

  @@index([assetId, performedAt])
}
