generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String         @id @default(cuid())
  username           String         @unique
  passwordHash       String
  role               String         @default("admin") // admin | technician | display
  technicianId       String?        @unique
  technician         Technician?    @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  active             Boolean        @default(true)
  mustChangePassword Boolean        @default(false)
  lastLoginAt        DateTime?
  // Secret in the calendar-feed URL; rotating it invalidates any subscribed calendar.
  feedToken          String?        @unique
  createdAt          DateTime       @default(now())
  notifications      Notification[]
}

// A short message for one signed-in person: a job assigned to them, something due
// or overdue, a status change on their work. Dedupe keys stop the scheduler from
// repeating the same reminder every run.
model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  at         DateTime  @default(now())
  kind       String
  title      String
  body       String?
  issueId    String?
  propertyId String?
  dedupeKey  String?
  readAt     DateTime?

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, at])
}

model Activity {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  userId     String?
  username   String
  action     String
  entityType String
  entityId   String
  propertyId String?
  issueId    String?
  summary    String
  details    String?

  @@index([issueId])
  @@index([propertyId])
  @@index([at])
}

model Session {
  id        String   @id
  data      String
  expiresAt DateTime
}

model Technician {
  id          String      @id @default(cuid())
  name        String
  trade       String?
  phone       String?
  color       String      @default("#2563eb")
  active      Boolean     @default(true)
  // Hours available per weekday, Monday first, stored as a JSON array of 7 numbers.
  // Either 7 numbers (legacy hours per day) or 7 shift objects {start,end} / null,
  // Monday first. Read through parseShifts, which normalises both shapes.
  weeklyHours String      @default("[{\"start\":\"08:00\",\"end\":\"16:00\"},{\"start\":\"08:00\",\"end\":\"16:00\"},{\"start\":\"08:00\",\"end\":\"16:00\"},{\"start\":\"08:00\",\"end\":\"16:00\"},{\"start\":\"08:00\",\"end\":\"16:00\"},null,null]")
  // Work categories this technician covers, as a JSON array of category keys.
  categories  String      @default("[]")
  // Charge-out rate used to value clocked time on an issue.
  hourlyRate  Float?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  issues      Issue[]
  timeEntries TimeEntry[]
  schedules   Schedule[]
  user        User?
}

model Property {
  id            String        @id @default(cuid())
  name          String
  address       String?
  notes         String?
  // GeoJSON Polygon geometry, stored as JSON text: { "type": "Polygon", "coordinates": [...] }
  boundary      String?
  centerLat     Float?
  centerLng     Float?
  // Secret in the public guest-reporting link. Null until an admin turns it on;
  // rotating it kills every QR code and printed card already in circulation.
  intakeToken   String?       @unique
  intakeEnabled Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  issues        Issue[]
  schedules     Schedule[]
  guestReports  GuestReport[]
}

model Issue {
  id               String          @id @default(cuid())
  propertyId       String
  property         Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  actionNeeded     String?
  priority         String          @default("medium") // low | medium | high | urgent
  status           String          @default("pending") // pending | in_progress | completed
  // Trade the work belongs to, used to suggest who should pick it up.
  category         String?
  // Room or sub-location within the property, e.g. "Room 214" or "Pool plant room".
  roomName         String?
  workOrderCreated Boolean         @default(false)
  workOrderNumber  String?
  workOrderUrl     String?
  lat              Float
  lng              Float
  closedAt         DateTime?
  technicianId     String?
  technician       Technician?     @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  estimatedHours   Float?
  actualHours      Float?
  // Calendar days as YYYY-MM-DD in the user's local time: when work is planned to start,
  // and when it must be done by.
  scheduledFor     String?
  dueDate          String?
  // Set when the scheduler last raised this issue's priority for being overdue.
  escalatedAt      DateTime?
  // Set when a recurring maintenance schedule created this issue.
  scheduleId       String?
  schedule         Schedule?       @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  photos           Photo[]
  timeEntries      TimeEntry[]
  checklist        ChecklistItem[]
  costs            Cost[]
  tags             IssueTag[]
  messages         Message[]
  guestReport      GuestReport?

  @@index([propertyId])
  @@index([technicianId])
}

// One stretch of work on an issue, recorded by clocking in and out. A technician has
// at most one open entry (no endedAt) at a time; the issue's actualHours is the sum.
model TimeEntry {
  id           String     @id @default(cuid())
  issueId      String
  issue        Issue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  userId       String?
  startedAt    DateTime   @default(now())
  endedAt      DateTime?
  note         String?
  createdAt    DateTime   @default(now())

  @@index([issueId])
  @@index([technicianId, startedAt])
}

// Belongs to an issue, or to a guest report until that report is accepted and the
// photos move across with it. Exactly one of the two is set.
model Photo {
  id            String       @id @default(cuid())
  issueId       String?
  issue         Issue?       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  guestReportId String?
  guestReport   GuestReport? @relation(fields: [guestReportId], references: [id], onDelete: Cascade)
  filename      String
  thumbFilename String?
  hasGps        Boolean      @default(false)
  gpsLat        Float?
  gpsLng        Float?
  takenAt       DateTime?
  createdAt     DateTime     @default(now())

  @@index([issueId])
  @@index([guestReportId])
}

// Organisation-wide settings (turnaround days per priority, escalation rules), one JSON row.
model Setting {
  id        String   @id
  json      String
  updatedAt DateTime @updatedAt
}

// A recurring maintenance task (gutters every 3 months, boiler service yearly…). The
// scheduler turns it into a normal issue `leadDays` before each due date.
model Schedule {
  id             String      @id @default(cuid())
  propertyId     String
  property       Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  actionNeeded   String?
  priority       String      @default("medium")
  category       String?
  roomName       String?
  technicianId   String?
  technician     Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  estimatedHours Float?
  lat            Float
  lng            Float
  every          Int         @default(1)
  unit           String      @default("months") // days | weeks | months
  leadDays       Int         @default(7)
  nextDue        String // YYYY-MM-DD
  checklist      String      @default("[]") // JSON array of item texts
  active         Boolean     @default(true)
  lastCreatedAt  DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  issues         Issue[]

  @@index([propertyId])
}

// Tick-box steps on an issue (from a schedule's template or added by hand).
model ChecklistItem {
  id       String    @id @default(cuid())
  issueId  String
  issue    Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  text     String
  position Int       @default(0)
  done     Boolean   @default(false)
  doneAt   DateTime?
  doneBy   String?

  @@index([issueId])
}

// An outside firm or tradesperson used for work the in-house crew doesn't cover.
model Contractor {
  id        String   @id @default(cuid())
  name      String
  trade     String?
  phone     String?
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  costs     Cost[]
}

// Money spent on an issue: parts, an invoice from a contractor, hire, disposal…
model Cost {
  id           String      @id @default(cuid())
  issueId      String
  issue        Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  kind         String      @default("parts") // parts | contractor | hire | other
  description  String
  amount       Float
  quantity     Float       @default(1)
  contractorId String?
  contractor   Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  invoiceRef   String?
  incurredOn   String // YYYY-MM-DD
  createdBy    String?
  createdAt    DateTime    @default(now())

  @@index([issueId])
  @@index([contractorId])
}

// A label for the kind of work, seeded with the hotel set and extendable by an admin.
model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String     @default("#475569")
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  issues    IssueTag[]
}

model IssueTag {
  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([issueId, tagId])
  @@index([tagId])
}

// A line in an issue's conversation. Kept separately from the issue so every remark
// carries who said it and when, and nothing overwrites anything else.
model Message {
  id         String    @id @default(cuid())
  issueId    String
  issue      Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId     String?
  authorName String
  body       String
  editedAt   DateTime?
  createdAt  DateTime  @default(now())

  @@index([issueId, createdAt])
}

// Something reported through a property's public link by someone with no login — a
// guest, a housekeeper, a front-desk shift. It is not an issue yet: an admin reads it
// and either accepts it (which creates the issue and moves the photos over) or turns
// it down, with the record kept either way.
model GuestReport {
  id           String    @id @default(cuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomName     String
  category     String?
  description  String
  status       String    @default("pending") // pending | accepted | declined
  // Taken from a submitted photo's EXIF when one had GPS, so the pin starts in the
  // right place; null means the reviewer positions it themselves.
  lat          Float?
  lng          Float?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   String?
  reviewNote   String?
  issueId      String?   @unique
  issue        Issue?    @relation(fields: [issueId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  photos       Photo[]

  @@index([status, createdAt])
  @@index([propertyId])
}
