generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String      @id @default(cuid())
  username           String      @unique
  passwordHash       String
  role               String      @default("admin") // admin | technician | display
  technicianId       String?     @unique
  technician         Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  active             Boolean     @default(true)
  mustChangePassword Boolean     @default(false)
  lastLoginAt        DateTime?
  // Secret in the calendar-feed URL; rotating it invalidates any subscribed calendar.
  feedToken          String?     @unique
  createdAt          DateTime    @default(now())
  notifications      Notification[]
}

// A short message for one signed-in person: a job assigned to them, something due
// or overdue, a status change on their work. Dedupe keys stop the scheduler from
// repeating the same reminder every run.
model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  at         DateTime  @default(now())
  kind       String
  title      String
  body       String?
  issueId    String?
  propertyId String?
  dedupeKey  String?
  readAt     DateTime?

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, at])
}

model Activity {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  userId     String?
  username   String
  action     String
  entityType String
  entityId   String
  propertyId String?
  issueId    String?
  summary    String
  details    String?

  @@index([issueId])
  @@index([propertyId])
  @@index([at])
}

model Session {
  id        String   @id
  data      String
  expiresAt DateTime
}

model Technician {
  id          String   @id @default(cuid())
  name        String
  trade       String?
  phone       String?
  color       String   @default("#2563eb")
  active      Boolean  @default(true)
  // Hours available per weekday, Monday first, stored as a JSON array of 7 numbers.
  weeklyHours String   @default("[8,8,8,8,8,0,0]")
  // Charge-out rate used to value clocked time on an issue.
  hourlyRate  Float?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  issues      Issue[]
  timeEntries TimeEntry[]
  schedules   Schedule[]
  user        User?
}

model Property {
  id        String   @id @default(cuid())
  name      String
  address   String?
  notes     String?
  // GeoJSON Polygon geometry, stored as JSON text: { "type": "Polygon", "coordinates": [...] }
  boundary  String?
  centerLat Float?
  centerLng Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  issues    Issue[]
  schedules Schedule[]
}

model Issue {
  id               String   @id @default(cuid())
  propertyId       String
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  actionNeeded     String?
  priority         String   @default("medium") // low | medium | high | urgent
  status           String   @default("pending") // pending | in_progress | completed
  workOrderCreated Boolean  @default(false)
  workOrderNumber  String?
  workOrderUrl     String?
  comments         String?
  lat              Float
  lng              Float
  closedAt         DateTime?
  technicianId     String?
  technician       Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  estimatedHours   Float?
  actualHours      Float?
  // Calendar days as YYYY-MM-DD in the user's local time: when work is planned to start,
  // and when it must be done by.
  scheduledFor     String?
  dueDate          String?
  // Set when the scheduler last raised this issue's priority for being overdue.
  escalatedAt      DateTime?
  // Set when a recurring maintenance schedule created this issue.
  scheduleId       String?
  schedule         Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  photos           Photo[]
  timeEntries      TimeEntry[]
  checklist        ChecklistItem[]
  costs            Cost[]

  @@index([propertyId])
  @@index([technicianId])
}

// One stretch of work on an issue, recorded by clocking in and out. A technician has
// at most one open entry (no endedAt) at a time; the issue's actualHours is the sum.
model TimeEntry {
  id           String     @id @default(cuid())
  issueId      String
  issue        Issue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  userId       String?
  startedAt    DateTime   @default(now())
  endedAt      DateTime?
  note         String?
  createdAt    DateTime   @default(now())

  @@index([issueId])
  @@index([technicianId, startedAt])
}

model Photo {
  id        String    @id @default(cuid())
  issueId   String
  issue     Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  filename      String
  thumbFilename String?
  hasGps        Boolean   @default(false)
  gpsLat    Float?
  gpsLng    Float?
  takenAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([issueId])
}

// Organisation-wide settings (turnaround days per priority, escalation rules), one JSON row.
model Setting {
  id        String   @id
  json      String
  updatedAt DateTime @updatedAt
}

// A recurring maintenance task (gutters every 3 months, boiler service yearly…). The
// scheduler turns it into a normal issue `leadDays` before each due date.
model Schedule {
  id             String      @id @default(cuid())
  propertyId     String
  property       Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  actionNeeded   String?
  priority       String      @default("medium")
  technicianId   String?
  technician     Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  estimatedHours Float?
  lat            Float
  lng            Float
  every          Int         @default(1)
  unit           String      @default("months") // days | weeks | months
  leadDays       Int         @default(7)
  nextDue        String      // YYYY-MM-DD
  checklist      String      @default("[]") // JSON array of item texts
  active         Boolean     @default(true)
  lastCreatedAt  DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  issues         Issue[]

  @@index([propertyId])
}

// Tick-box steps on an issue (from a schedule's template or added by hand).
model ChecklistItem {
  id       String    @id @default(cuid())
  issueId  String
  issue    Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  text     String
  position Int       @default(0)
  done     Boolean   @default(false)
  doneAt   DateTime?
  doneBy   String?

  @@index([issueId])
}

// An outside firm or tradesperson used for work the in-house crew doesn't cover.
model Contractor {
  id        String   @id @default(cuid())
  name      String
  trade     String?
  phone     String?
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  costs     Cost[]
}

// Money spent on an issue: parts, an invoice from a contractor, hire, disposal…
model Cost {
  id           String      @id @default(cuid())
  issueId      String
  issue        Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  kind         String      @default("parts") // parts | contractor | hire | other
  description  String
  amount       Float
  quantity     Float       @default(1)
  contractorId String?
  contractor   Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  invoiceRef   String?
  incurredOn   String      // YYYY-MM-DD
  createdBy    String?
  createdAt    DateTime    @default(now())

  @@index([issueId])
  @@index([contractorId])
}
