DATABASE_URL="file:./dev.db"
PORT=4000

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-random-64-char-hex-string"

# Comma-separated list of origins allowed to call the API with credentials.
CLIENT_ORIGIN="http://localhost:5173"

# Set to any non-empty value when running behind a reverse proxy (nginx, Caddy, etc.)
# so secure cookies and client IPs are handled correctly.
# TRUST_PROXY=1

# Set by your process manager / deployment platform, not here:
# NODE_ENV=production
