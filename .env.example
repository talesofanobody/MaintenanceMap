# Settings for a self-hosted install (docker compose). Copy to .env and fill in.
# The .env file holds a secret, so it stays out of git — see .gitignore.

# Required. Anyone who has this can forge a login cookie, so generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The address people will open, used for the links and QR codes you print.
# Leave the tunnel token blank if you are only using this on your own network.
CLOUDFLARE_TUNNEL_TOKEN=

# How many nightly backups to keep before the oldest is deleted.
BACKUP_KEEP=14
